{
  "name": "tree-sitter-zql",
  "version": "0.1.0",
  "tree-sitter": [
    {
      "scope": "source.zql",
      "file-types": [
        ".zql"
      ]
    }
  ],
  "description": "Zql grammar for tree-sitter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tree-sitter/tree-sitter-zql.git"
  },
  "license": "MIT",
  "author": "ThunderFlight",
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "zql"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.2.1",
    "node-gyp-build": "^4.8.2",
    "tree-sitter-cli": "^0.24.7"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1"
  },
  "peerDependencies": {
    "tree-sitter": "^0.21.1"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/tree-sitter/tree-sitter-zql/issues"
  },
  "homepage": "https://github.com/tree-sitter/tree-sitter-zql#readme"
}
