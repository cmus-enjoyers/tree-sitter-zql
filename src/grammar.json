{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "zql",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "_statement"
          },
          {
            "type": "SYMBOL",
            "name": "comment"
          }
        ]
      }
    },
    "_statement": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "addFrom_statement"
        },
        {
          "type": "SYMBOL",
          "name": "require_statement"
        },
        {
          "type": "SYMBOL",
          "name": "hide_statement"
        }
      ]
    },
    "require_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "require"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "SYMBOL",
                "name": "identifier"
              },
              {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SEQ",
                    "members": [
                      {
                        "type": "STRING",
                        "value": "as"
                      },
                      {
                        "type": "SYMBOL",
                        "name": "identifier"
                      }
                    ]
                  },
                  {
                    "type": "BLANK"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "addFrom_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "add"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "all"
                },
                {
                  "type": "STRING",
                  "value": "from"
                },
                {
                  "type": "SYMBOL",
                  "name": "identifier"
                }
              ]
            },
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "identifier"
                },
                {
                  "type": "STRING",
                  "value": "from"
                },
                {
                  "type": "SYMBOL",
                  "name": "identifier"
                }
              ]
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "whereContains_statement"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "hide_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "hide"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        }
      ]
    },
    "whereContains_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "where"
        },
        {
          "type": "SYMBOL",
          "name": "identifier_member"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "contains"
                },
                {
                  "type": "SYMBOL",
                  "name": "string"
                }
              ]
            },
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "or"
                },
                {
                  "type": "SEQ",
                  "members": [
                    {
                      "type": "SYMBOL",
                      "name": "identifier"
                    },
                    {
                      "type": "STRING",
                      "value": "contains"
                    },
                    {
                      "type": "SYMBOL",
                      "name": "string"
                    }
                  ]
                }
              ]
            },
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "is"
                },
                {
                  "type": "SYMBOL",
                  "name": "string"
                }
              ]
            }
          ]
        }
      ]
    },
    "identifier_member": {
      "type": "PATTERN",
      "value": "[A-Za-z0-9_-]+"
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[A-Za-z0-9_-]+"
    },
    "comment": {
      "type": "PATTERN",
      "value": "\\;.*"
    },
    "string": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "\""
        },
        {
          "type": "PATTERN",
          "value": "[^\"]*"
        },
        {
          "type": "STRING",
          "value": "\""
        }
      ]
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}